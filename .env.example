# Anthropic (required for default model)
ANTHROPIC_API_KEY=

# OpenAI (optional)
OPENAI_API_KEY=

# Google Gemini (optional)
GEMINI_API_KEY=

# Groq (optional)
GROQ_API_KEY=

# OpenRouter (optional)
OPENROUTER_API_KEY=

# xAI / Grok (optional)
XAI_API_KEY=

# Exa web search (optional)
EXA_API_KEY=

# Docker services (used by make db-up / db-migrate)
# MAESTRO_REDIS_URL=redis://localhost:6379
# MAESTRO_DATABASE_URL=postgresql://localhost:5432/maestro?user=maestro&password=maestro

# Local Cerebro facts and MCP wiring. These match Cerebro's local Makefile
# defaults, so `make cerebro-e2e` and direct local Maestro runs talk to the same
# service when both repos are checked out locally.
MAESTRO_CEREBRO_URL=http://localhost:18080
MAESTRO_CEREBRO_WORKSPACE_ID=org_evalops_fixture
MAESTRO_WORKSPACE_ID=org_evalops_fixture
MAESTRO_CEREBRO_TIMEOUT_MS=5000
MAESTRO_CEREBRO_MAX_ATTEMPTS=2
MAESTRO_CEREBRO_SEARCH_LIMIT=8
MAESTRO_CEREBRO_CHANGE_LIMIT=20

MAESTRO_PLATFORM_MCP_URL=http://localhost:18080/mcp
MAESTRO_CEREBRO_MCP_SCOPES=cerebro:read
MAESTRO_EVALOPS_MEMORY_MODE=cerebro

# Override default model/provider
# MAESTRO_MODEL=claude-opus-4-6
# MAESTRO_MODEL_PROVIDER=anthropic
