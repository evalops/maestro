#!/bin/sh
set -eu

root="$(git rev-parse --show-toplevel)"
cd "$root"

if ! command -v cargo >/dev/null 2>&1; then
	echo "error: cargo is required to commit Maestro changes." >&2
	exit 1
fi

for manifest in \
	packages/maestro-rs/Cargo.toml \
	packages/control-plane-rs/Cargo.toml \
	packages/tui-rs/Cargo.toml \
	packages/ambient-agent-rs/Cargo.toml
do
	echo "rustfmt: checking $manifest"
	cargo fmt --manifest-path "$manifest" -- --check
done

node scripts/check-rust-only-runtime.mjs
