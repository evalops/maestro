{
  "harness": "safety",
  "name": "synthetic_safety_doom_loop_identical_calls",
  "description": "Agent retries the exact same bash call; the third consecutive identical call must trip the doom-loop gate at the default threshold.",
  "steps": [
    { "kind": "check", "tool": "bash", "args": { "command": "cat missing.txt" }, "expected": "allow" },
    { "kind": "record", "tool": "bash", "args": { "command": "cat missing.txt" } },
    { "kind": "check", "tool": "bash", "args": { "command": "cat missing.txt" }, "expected": "allow" },
    { "kind": "record", "tool": "bash", "args": { "command": "cat missing.txt" } },
    {
      "kind": "check",
      "tool": "bash",
      "args": { "command": "cat missing.txt" },
      "expected": "block_doom_loop",
      "expected_reason_contains": ["doom loop", "\"bash\""]
    },
    { "kind": "reset" },
    { "kind": "check", "tool": "bash", "args": { "command": "cat missing.txt" }, "expected": "allow" }
  ]
}
