#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 2 ]]; then
  echo "usage: $0 '<mise tool specs>' command [args...]" >&2
  exit 2
fi

tool_list="$1"
shift

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "${repo_root}"

mise_version="2026.4.24"
mise_sha256="4ecf49b825741e1e3e8ff8c92ee242cf728da951d1b3592ef1c2f080201fa454"
cache_root="${BUILDKITE_BUILD_CHECKOUT_PATH:-${repo_root}}/.buildkite/cache"
runtime_root="${cache_root}/runtime"
mkdir -p "${runtime_root}/bin" "${runtime_root}/mise/data" "${runtime_root}/mise/cache" \
  "${runtime_root}/cargo/bin" "${runtime_root}/rustup" "${cache_root}/tmp"

export MISE_DATA_DIR="${MISE_DATA_DIR:-${runtime_root}/mise/data}"
export MISE_CACHE_DIR="${MISE_CACHE_DIR:-${runtime_root}/mise/cache}"
export CARGO_HOME="${CARGO_HOME:-${runtime_root}/cargo}"
export RUSTUP_HOME="${RUSTUP_HOME:-${runtime_root}/rustup}"
export RUNNER_TEMP="${RUNNER_TEMP:-${cache_root}/tmp}"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${cache_root}/cargo-target}"
export npm_config_cache="${npm_config_cache:-${cache_root}/npm}"
export RUSTUP_INIT_SKIP_PATH_CHECK=yes
export MISE_EXEC_AUTO_INSTALL=false
export PATH="${runtime_root}/bin:${CARGO_HOME}/bin:${PATH}"

mise_reports_pinned_version() {
  [[ -x "$1" ]] && "$1" --version 2>/dev/null | grep -Eq "(^|[[:space:]])${mise_version}([[:space:]]|$)"
}

mise_bin="${EVALOPS_MISE_BIN:-}"
if [[ -n "${mise_bin}" ]] && ! mise_reports_pinned_version "${mise_bin}"; then
  echo "Ignoring EVALOPS_MISE_BIN=${mise_bin}: expected mise ${mise_version}." >&2
  mise_bin=""
fi
if [[ -z "${mise_bin}" ]] && command -v mise >/dev/null 2>&1; then
  discovered_mise="$(command -v mise)"
  if mise_reports_pinned_version "${discovered_mise}"; then
    mise_bin="${discovered_mise}"
  fi
fi
if [[ -z "${mise_bin}" ]]; then
  mise_bin="${runtime_root}/bin/mise-${mise_version}"
fi

if [[ ! -x "${mise_bin}" ]]; then
  mise_download="${cache_root}/mise-v${mise_version}-linux-x64"
  if ! curl -fsSLo "${mise_download}" --retry 5 --retry-all-errors --retry-delay 3 \
    --connect-timeout 15 \
    "https://github.com/jdx/mise/releases/download/v${mise_version}/mise-v${mise_version}-linux-x64"; then
    curl -fsSLo "${mise_download}" --retry 5 --retry-all-errors --retry-delay 3 \
      --connect-timeout 15 \
      "https://mise.jdx.dev/v${mise_version}/mise-v${mise_version}-linux-x64"
  fi
  printf '%s  %s\n' "${mise_sha256}" "${mise_download}" | sha256sum --check --status
  install -m 0755 "${mise_download}" "${mise_bin}"
fi

read -r -a tools <<< "${tool_list}"
for tool in "${tools[@]}"; do
  "${mise_bin}" install "${tool}"
done

if [[ " ${tool_list} " == *" rust@"* ]]; then
  "${mise_bin}" exec "${tools[@]}" -- rustup component add rustfmt clippy
fi

export EVALOPS_MISE_BIN="${mise_bin}"
"${mise_bin}" exec "${tools[@]}" -- "$@"
