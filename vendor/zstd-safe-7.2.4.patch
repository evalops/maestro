diff --git a/src/tests.rs b/src/tests.rs
--- a/src/tests.rs
+++ b/src/tests.rs
@@ -330,3 +330,24 @@
     let decompressed = &buffer[..written];
     assert_eq!(INPUT, decompressed);
 }
+
+#[test]
+#[should_panic(expected = "Given position outside of the buffer bounds")]
+fn out_buffer_rejects_uninitialized_prefix() {
+    let mut bytes = Vec::<u8>::with_capacity(128);
+    let _ = super::OutBuffer::around_pos(&mut bytes, 64);
+}
+
+#[test]
+fn out_buffer_preserves_initialized_prefix() {
+    let mut bytes = std::vec![42; 64];
+    bytes.reserve(128);
+    let mut context = super::CCtx::create();
+    context.init(1).unwrap();
+    let mut output = super::OutBuffer::around_pos(&mut bytes, 64);
+    context.compress_stream2(&mut output, &mut super::InBuffer::around(&[]),
+        zstd_sys::ZSTD_EndDirective::ZSTD_e_end).unwrap();
+    drop(output);
+    assert_eq!(&bytes[..64], &[42; 64]);
+    assert!(bytes.len() > 64);
+}
