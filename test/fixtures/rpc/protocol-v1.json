{
	"version": 1,
	"schema": "evalops.maestro.rpc-protocol-conformance.v1",
	"description": "Release-gated JSON-over-stdio RPC/headless launch and dispatch contract. Native maestro-tui --headless owns the protocol; typed client is NativeHeadlessClient (TS RpcClient residual removed).",
	"commands": [
		{
			"name": "prompt dispatches a user prompt",
			"type": "prompt",
			"request": {
				"id": "req_prompt",
				"type": "prompt",
				"message": "Summarize the workspace."
			},
			"response": {
				"kind": "agent-event-stream",
				"echoesRequestId": false
			}
		},
		{
			"name": "abort cancels the active run",
			"type": "abort",
			"request": {
				"id": "req_abort",
				"type": "abort"
			},
			"response": {
				"kind": "no-body",
				"echoesRequestId": false
			}
		},
		{
			"name": "get_messages returns correlated conversation messages",
			"type": "get_messages",
			"request": {
				"id": "req_messages",
				"type": "get_messages"
			},
			"response": {
				"type": "messages",
				"echoesRequestId": true,
				"requiredFields": ["messages"]
			}
		},
		{
			"name": "get_state returns correlated agent state",
			"type": "get_state",
			"request": {
				"id": "req_state",
				"type": "get_state"
			},
			"response": {
				"type": "state",
				"echoesRequestId": true,
				"requiredFields": [
					"state.model",
					"state.messages",
					"state.queuedMessageCount"
				]
			}
		},
		{
			"name": "continue resumes the conversation",
			"type": "continue",
			"request": {
				"id": "req_continue",
				"type": "continue",
				"options": {
					"systemPromptOverride": "Keep the reply short."
				}
			},
			"response": {
				"kind": "agent-event-stream",
				"echoesRequestId": false
			}
		},
		{
			"name": "compact returns a correlated compaction result",
			"type": "compact",
			"request": {
				"id": "req_compact",
				"type": "compact",
				"customInstructions": "Keep release evidence."
			},
			"response": {
				"type": "compaction",
				"echoesRequestId": true,
				"requiredFields": [
					"summary",
					"firstKeptEntryIndex",
					"tokensBefore",
					"auto"
				]
			}
		},
		{
			"name": "unknown commands return correlated errors",
			"type": "unknown",
			"request": {
				"id": "req_unknown",
				"type": "missing_command"
			},
			"response": {
				"type": "error",
				"echoesRequestId": true,
				"requiredFields": ["error"]
			}
		}
	],
	"runtimeSurfaces": [
		{
			"area": "rpc-server-dispatch",
			"path": "packages/tui-rs/src/headless_server.rs",
			"anchors": [
				"run_headless_server",
				"ToAgentMessage::Prompt",
				"ToAgentMessage::Hello",
				"FromAgentMessage::Ready"
			],
			"note": "TS RPC server removed; native maestro-tui --headless owns the protocol."
		},
		{
			"area": "rpc-server-native",
			"path": "packages/tui-rs/src/headless_server.rs",
			"anchors": [
				"run_headless_server",
				"ToAgentMessage::Prompt",
				"ToAgentMessage::Hello",
				"FromAgentMessage::Ready"
			]
		},
		{
			"area": "rpc-server-request-id-correlation",
			"path": "src/cli/native-tui-launcher.ts",
			"anchors": [
				"shouldLaunchNativeHeadless",
				"launchNativeTui",
				"parsed.headless"
			]
		},
		{
			"area": "rpc-client-launch",
			"path": "src/server/native-headless-client.ts",
			"anchors": [
				"export class NativeHeadlessClient",
				"spawnNativeHeadlessProcess",
				"async start(): Promise<HeadlessReadyMessage>",
				"prompt(content: string"
			],
			"note": "TS RpcClient (src/rpc/) deleted; NativeHeadlessClient is the production NDJSON client for maestro-tui --headless / --mode rpc."
		},
		{
			"area": "rpc-type-union",
			"path": "src/cli/headless-protocol.ts",
			"anchors": [
				"export interface HeadlessPromptMessage",
				"export interface HeadlessInterruptMessage",
				"export interface HeadlessCancelMessage",
				"export interface HeadlessShutdownMessage",
				"export type HeadlessToAgentMessage",
				"export type HeadlessFromAgentMessage"
			],
			"note": "Headless protocol message unions replaced legacy RpcCommand / RpcResponse types."
		},
		{
			"area": "rpc-runtime-tests",
			"path": "test/cli/native-tui-launcher.test.ts",
			"anchors": [
				"routes headless and rpc modes to native headless server",
				"shouldLaunchNativeHeadless"
			],
			"note": "TS RPC suite deleted; protocol runtime is covered by native headless + launcher surfaces."
		}
	]
}
