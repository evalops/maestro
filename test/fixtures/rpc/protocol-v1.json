{
	"version": 1,
	"schema": "evalops.maestro.rpc-protocol-conformance.v1",
	"description": "Release-gated JSON-over-stdio RPC command, response, request-id correlation, and client launch contract. Native headless owns stdio RPC/headless protocol after TS agent kill.",
	"commands": [
		{
			"name": "prompt dispatches a user prompt",
			"type": "prompt",
			"request": {
				"id": "req_prompt",
				"type": "prompt",
				"message": "Summarize the workspace."
			},
			"response": {
				"kind": "agent-event-stream",
				"echoesRequestId": false
			}
		},
		{
			"name": "abort cancels the active run",
			"type": "abort",
			"request": {
				"id": "req_abort",
				"type": "abort"
			},
			"response": {
				"kind": "no-body",
				"echoesRequestId": false
			}
		},
		{
			"name": "get_messages returns correlated conversation messages",
			"type": "get_messages",
			"request": {
				"id": "req_messages",
				"type": "get_messages"
			},
			"response": {
				"type": "messages",
				"echoesRequestId": true,
				"requiredFields": ["messages"]
			}
		},
		{
			"name": "get_state returns correlated agent state",
			"type": "get_state",
			"request": {
				"id": "req_state",
				"type": "get_state"
			},
			"response": {
				"type": "state",
				"echoesRequestId": true,
				"requiredFields": [
					"state.model",
					"state.messages",
					"state.queuedMessageCount"
				]
			}
		},
		{
			"name": "continue resumes the conversation",
			"type": "continue",
			"request": {
				"id": "req_continue",
				"type": "continue",
				"options": {
					"systemPromptOverride": "Keep the reply short."
				}
			},
			"response": {
				"kind": "agent-event-stream",
				"echoesRequestId": false
			}
		},
		{
			"name": "compact returns a correlated compaction result",
			"type": "compact",
			"request": {
				"id": "req_compact",
				"type": "compact",
				"customInstructions": "Keep release evidence."
			},
			"response": {
				"type": "compaction",
				"echoesRequestId": true,
				"requiredFields": [
					"summary",
					"firstKeptEntryIndex",
					"tokensBefore",
					"auto"
				]
			}
		},
		{
			"name": "unknown commands return correlated errors",
			"type": "unknown",
			"request": {
				"id": "req_unknown",
				"type": "missing_command"
			},
			"response": {
				"type": "error",
				"echoesRequestId": true,
				"requiredFields": ["error"]
			}
		}
	],
	"runtimeSurfaces": [
		{
			"area": "rpc-server-dispatch",
			"path": "src/cli/rpc-mode.ts",
			"anchors": [
				"TypeScript runRpcMode has been removed",
				"maestro-tui --headless"
			],
			"note": "TS RPC server removed; native maestro-tui --headless owns the protocol."
		},
		{
			"area": "rpc-server-native",
			"path": "packages/tui-rs/src/headless_server.rs",
			"anchors": [
				"run_headless_server",
				"ToAgentMessage::Prompt",
				"ToAgentMessage::Hello",
				"FromAgentMessage::Ready"
			]
		},
		{
			"area": "rpc-server-request-id-correlation",
			"path": "src/cli/native-tui-launcher.ts",
			"anchors": [
				"shouldLaunchNativeHeadless",
				"launchNativeTui",
				"parsed.headless"
			]
		},
		{
			"area": "rpc-client-launch",
			"path": "src/rpc/rpc-client.ts",
			"anchors": [
				"[\"--mode\", \"rpc\"]",
				"commandWithId",
				"this.pending.set(id"
			]
		},
		{
			"area": "rpc-type-union",
			"path": "src/rpc/rpc-types.ts",
			"anchors": [
				"RpcPromptCommand",
				"RpcAbortCommand",
				"RpcGetMessagesCommand",
				"RpcGetStateCommand",
				"RpcContinueCommand",
				"RpcCompactCommand"
			]
		},
		{
			"area": "rpc-runtime-tests",
			"path": "test/cli/rpc-mode.test.ts",
			"anchors": [
				"throws a removal error directing callers to native headless",
				"TypeScript runRpcMode has been removed",
				"maestro-tui --headless"
			],
			"note": "TS RPC suite is a fail-closed stub; protocol runtime is covered by native headless + launcher surfaces."
		}
	]
}
